programa {
  funcao inicio() {
    cadeia nome
    inteiro idade
    cadeia cidade
    escreva ("digite seu nome: ")
leia (nome)
escreva ("digite sua idade: ")
leia (idade)
escreva ("digite o nome de sua cidade: ")
leia (cidade)

escreva ("o seu nome é ", nome) 
escreva (" ")
escreva ("sua idade é ", idade)
escreva (" ")
escreva ("sua cidade é a cidade de ", cidade)
  }
}