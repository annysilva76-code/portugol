programa {
  funcao inicio() {
    inteiro nota1
    inteiro nota2
inteiro media
escreva ("digite sua primeira nota: ")
leia (nota1)
escreva ("digite sua segunda nota: ")
leia (nota2)

media= (nota1 + nota2) /2
se (media >= 7) {
  escreva ("você foi aprovado! parabéns você tirou ", media)
}
senao {
  escreva ("você foi reprovado! sua media foi ",media, "!melhore :(")
}


  }
}
